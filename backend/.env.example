# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=MediSync AI
APP_ENV=development
SECRET_KEY=change_this_to_a_very_long_random_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://medisync_user:medisync_pass@localhost:5432/medisync_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:medisync_redis_pass@localhost:6379/0

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=medisync_minio
MINIO_SECRET_KEY=medisync_minio_secret
MINIO_BUCKET_MEDICAL_IMAGES=medical-images
MINIO_USE_SSL=false

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=your_openai_or_huggingface_api_key
LLM_MODEL=gpt-3.5-turbo
LLM_USE_LOCAL=false
